# dependencies (unanchored: matches at any depth, since every workspace
# package under apps/*, packages/* has its own node_modules)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
!.env.example

# local turso/sqlite database
local.db*

# typescript
*.tsbuildinfo
next-env.d.ts
