# Turso (libSQL) connection — the only persistence backend (Constitution III).
# Copy this file to .env.local and fill in the values.

# Local development: a plain SQLite file in the repo root.
# Hosted Turso: libsql://<database>-<org>.turso.io
TURSO_DATABASE_URL=file:local.db

# Required only for hosted Turso; leave empty for a local file: database.
TURSO_AUTH_TOKEN=
